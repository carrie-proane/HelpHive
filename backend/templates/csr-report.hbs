<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{{company.name}} Impact Report</title>
    <style>
      :root {
        --coral: #e07a6a;
        --teal: #6aa89e;
        --sand: #f2e6d8;
        --charcoal: #2b2b2b;
        --off-white: #faf7f2;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 34px;
        font-family: "Manrope", Arial, sans-serif;
        color: var(--charcoal);
        background: linear-gradient(180deg, #f8f2ea 0%, #f6ecdf 100%);
      }

      .brand-row {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 18px;
      }

      .brand-mark {
        width: 52px;
        height: 52px;
        border-radius: 18px;
        background: linear-gradient(135deg, rgba(224, 122, 106, 0.96), rgba(106, 168, 158, 0.86));
        position: relative;
      }

      .brand-mark::before {
        content: "";
        position: absolute;
        inset: 15px;
        border-radius: 999px;
        background: rgba(250, 247, 242, 0.92);
        box-shadow: 12px 6px 0 -5px rgba(250, 247, 242, 0.84), -10px 7px 0 -6px rgba(250, 247, 242, 0.72);
      }

      .brand-copy strong,
      .brand-copy span {
        display: block;
      }

      .brand-copy span {
        color: rgba(250, 247, 242, 0.8);
        margin-top: 4px;
      }

      .hero {
        padding: 28px 32px;
        border-radius: 28px;
        background: linear-gradient(135deg, rgba(224, 122, 106, 0.94), rgba(94, 59, 52, 0.96));
        color: var(--off-white);
      }

      .hero h1,
      .section h2 {
        margin: 0;
        font-family: "Georgia", serif;
        letter-spacing: -0.04em;
      }

      .hero p {
        margin: 14px 0 0;
        max-width: 700px;
        line-height: 1.65;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-top: 24px;
      }

      .card,
      .story,
      .line-item {
        border-radius: 24px;
        padding: 20px;
        background: rgba(250, 247, 242, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.65);
      }

      .card strong {
        display: block;
        font-size: 28px;
        margin-top: 10px;
      }

      .section {
        margin-top: 28px;
      }

      .section p {
        line-height: 1.7;
      }

      .chart-row {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 18px;
      }

      .bars {
        display: flex;
        align-items: end;
        gap: 12px;
        min-height: 210px;
        margin-top: 20px;
      }

      .bar {
        flex: 1;
        padding-top: 8px;
      }

      .bar-track {
        height: 180px;
        display: flex;
        align-items: end;
      }

      .bar-fill {
        width: 100%;
        border-radius: 16px 16px 10px 10px;
        background: linear-gradient(180deg, rgba(94, 59, 52, 0.92), rgba(224, 122, 106, 0.64));
      }

      .bar span,
      .bar small,
      .line-item small {
        display: block;
        margin-top: 10px;
        color: rgba(43, 43, 43, 0.72);
      }

      .line-list {
        display: grid;
        gap: 12px;
      }

      .line-item strong {
        display: block;
        font-size: 18px;
        margin-bottom: 6px;
      }

      .footer {
        margin-top: 30px;
        color: rgba(43, 43, 43, 0.62);
        font-size: 12px;
      }
    </style>
  </head>
  <body>
    <section class="hero">
      <div class="brand-row">
        <div class="brand-mark"></div>
        <div class="brand-copy">
          <strong>HelpHive</strong>
          <span>Branded civic coordination reporting</span>
        </div>
      </div>
      <h1>{{company.name}} Impact Report</h1>
      <p>{{narrative}}</p>
      <p>Generated on {{generatedAt}}</p>
    </section>

    <section class="section">
      <div class="grid">
        {{#each metricCards}}
          <article class="card">
            <span>{{label}}</span>
            <strong>{{value}}</strong>
            <p>{{description}}</p>
          </article>
        {{/each}}
      </div>
    </section>

    <section class="section chart-row">
      <article class="story">
        <h2>Monthly Volunteer Hours</h2>
        <div style="width:100%;">
            <canvas id="csrAreaCanvas" width="600" height="240" aria-label="Volunteer hours chart"></canvas>
            <div id="csrAreaLegend" style="margin-top:8px; font-size:12px; color: rgba(43,43,43,0.7);"></div>
          </div>
      </article>

      <article class="story">
        <h2>Completed Task Receipt</h2>
        <div class="line-list">
          {{#each receiptLines}}
            <div class="line-item">
              <strong>{{title}}</strong>
              <small>{{locationName}} · {{volunteers}} volunteers · {{completedAt}}</small>
              <small>{{outputMetric}}</small>
              <small>{{outcomeMetric}}</small>
            </div>
          {{/each}}
        </div>
      </article>
    </section>

    <section class="section chart-row" style="margin-top: 18px;">
      <article class="story" style="flex: 0.65;">
        <h2>Volunteer hours trend</h2>
        <canvas id="csrAreaSmall" width="420" height="220" aria-hidden="true"></canvas>
        <div id="csrAreaSmallLegend" style="margin-top:8px; font-size:12px; color: rgba(43,43,43,0.7);"></div>
      </article>
      <article class="story" style="flex: 0.35;">
        <h2>Task breakdown</h2>
        <canvas id="csrDonutCanvas" width="300" height="220" aria-label="Task breakdown chart"></canvas>
        <div id="csrDonutLegend" style="margin-top:8px; font-size:12px; color: rgba(43,43,43,0.7);"></div>
      </article>
    </section>

    <section class="section">
      <article class="story">
        <h2>Category Breakdown</h2>
        <p>
          {{#each categorySummary}}
            {{label}}: {{value}}{{#unless @last}}, {{/unless}}
          {{/each}}
        </p>
      </article>
    </section>

    <section class="section chart-row">
      <article class="story">
        <h2>Outcome Proxies</h2>
        <div class="line-list">
          {{#each outcomeMetrics}}
            <div class="line-item">
              <strong>{{label}}</strong>
              <small>{{value}}</small>
              <small>{{description}}</small>
            </div>
          {{/each}}
        </div>
      </article>

      <article class="story">
        <h2>Framework Alignment</h2>
        <div class="line-list">
          {{#each frameworkAlignment}}
            <div class="line-item">
              <strong>{{framework}}</strong>
              <small>{{focus}}</small>
            </div>
          {{/each}}
        </div>
      </article>
    </section>

    <section class="section">
      <article class="story">
        <h2>Impact Voices</h2>
        <div class="line-list">
          {{#each testimonials}}
            <div class="line-item">
              <strong>{{quote}}</strong>
              <small>{{attribution}}</small>
            </div>
          {{/each}}
        </div>
      </article>
    </section>

    <div class="footer">
      HelpHive civic coordination platform · This report translates funding and volunteer support into ward-level evidence.
    </div>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
      (function () {
        try {
          const report = {{{rawData}}} || { monthlyHours: [], categorySummary: [], totals: {} };

          function buildAreaChart(ctxId) {
            const canvas = document.getElementById(ctxId);
            const ctx = canvas?.getContext('2d');
            if (!ctx || !report.monthlyHours || !report.monthlyHours.length) return null;
            const labels = report.monthlyHours.map(m => m.month);
            const data = report.monthlyHours.map(m => m.hours || 0);

            // create a vertical gradient for the fill to improve visibility in PDF
            const g = ctx.createLinearGradient(0, 0, 0, canvas.height);
            g.addColorStop(0, 'rgba(224,122,106,0.24)');
            g.addColorStop(1, 'rgba(224,122,106,0.04)');

            const border = 'rgba(224,122,106,0.98)';

            const chart = new Chart(ctx, {
              type: 'line',
              data: {
                labels,
                datasets: [{
                  label: 'Volunteer hours',
                  data,
                  fill: true,
                  backgroundColor: g,
                  borderColor: border,
                  borderWidth: 3,
                  tension: 0.45,
                  pointRadius: 5,
                  pointBackgroundColor: border,
                  pointBorderColor: '#fff',
                  pointHoverRadius: 8
                }]
              },
              options: {
                responsive: false,
                plugins: { legend: { display: false } },
                scales: { x: { grid: { display: false } }, y: { beginAtZero: true } },
                elements: { line: { borderJoinStyle: 'round', borderCapStyle: 'round' } }
              }
            });

            // Render a simple legend below the canvas
            try {
              const legendContainer = document.getElementById(ctxId === 'csrAreaCanvas' ? 'csrAreaLegend' : 'csrAreaSmallLegend');
              if (legendContainer) {
                legendContainer.innerHTML = `<span style="display:inline-flex;align-items:center;gap:8px;"><span style="width:12px;height:12px;background:${border};display:inline-block;border-radius:2px;border:1px solid rgba(0,0,0,0.06);"></span>${chart.data.datasets[0].label}</span>`;
              }
            } catch (e) { /* ignore legend failures */ }

            return chart;
          }

          function buildDonutChart() {
            const canvas = document.getElementById('csrDonutCanvas');
            const ctx = canvas?.getContext('2d');
            if (!ctx || !report.categorySummary) return null;
            const labels = report.categorySummary.map(c => c.label);
            const data = report.categorySummary.map(c => c.value || 0);
            const total = data.reduce((sum, value) => sum + value, 0) || 1;
            const colors = ['#e07a6a','#6aa89e','#bda08a','#8e7cc3','#6cacd8'];

            const chart = new Chart(ctx, {
              type: 'doughnut',
              data: { labels, datasets: [{ data, backgroundColor: labels.map((_,i)=>colors[i%colors.length]) }] },
              options: { responsive: false, plugins: { legend: { display: false } }, cutout: '60%' }
            });

            // Build textual legend with color swatches and counts
            try {
              const legendContainer = document.getElementById('csrDonutLegend');
              if (legendContainer) {
                legendContainer.innerHTML = labels.map((lbl, i) => {
                  const val = data[i] || 0;
                  const percent = ((val / total) * 100).toFixed(1);
                  const color = colors[i % colors.length];
                  return `<div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;"><span style="width:12px;height:12px;border-radius:3px;background:${color};display:inline-block;border:1px solid rgba(0,0,0,0.06);"></span><span>${lbl}</span><span style="margin-left:auto;color:rgba(43,43,43,0.6);">${val} (${percent}%)</span></div>`;
                }).join('');
              }
            } catch (e) { /* ignore legend failures */ }

            return chart;
          }

          // build larger and small area charts if canvases exist
          buildAreaChart('csrAreaCanvas');
          buildAreaChart('csrAreaSmall');
          buildDonutChart();

          // Signal Puppeteer that charts are ready
          window.__helphiveChartsReady = true;
        } catch (e) {
          console.warn('Chart rendering failed', e);
          window.__helphiveChartsReady = true;
        }
      })();
    </script>
  </body>
</html>
